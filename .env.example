# Server
PORT=3000
NODE_ENV=production

# Auth — required in production, minimum 32 characters
SESSION_SECRET=change-me-to-at-least-32-random-characters

# Comma-separated list of allowed browser origins
CLIENT_ORIGINS=http://localhost:3000

# Turso / libsql database (optional — database features are disabled if unset)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Redis (optional — enables the Socket.io adapter for multi-instance deployments)
REDIS_URL=

# TURN server (optional — improves NAT traversal for WebRTC calls)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
